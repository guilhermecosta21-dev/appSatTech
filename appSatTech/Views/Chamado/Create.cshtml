@model appSatTech.Models.Chamado

@{
    ViewData["Title"] = "Abrir Chamado";
}

<h1>Abrir Chamado</h1>
<h4>TechHelp Support</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="DataHora" class="control-label">Data/Hora do Atendimento</label>
                <input asp-for="DataHora" class="form-control" />
                <span asp-validation-for="DataHora" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StatusConsulta" class="control-label">Status</label>
                <select class="form-control" disabled>
                    <option selected>Agendada</option>
                </select>
                <input type="hidden" name="StatusConsulta" value="Agendada" />
                <small class="form-text text-muted">
                    Todo chamado inicia como "Agendada". A alteração para "Realizada" ou
                    "Cancelada" é feita na edição do chamado.
                </small>
                <span asp-validation-for="StatusConsulta" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TecnicoId" class="control-label">Técnico</label>
                <select asp-for="TecnicoId" class="form-control" asp-items="ViewBag.TecnicoId">
                    <option value="">-- Selecione o Técnico --</option>
                </select>
                <span asp-validation-for="TecnicoId" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Cadastrar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}